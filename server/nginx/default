# /etc/nginx/sites-available/default
server {
	listen 80 default_server;
	listen [::]:80 default_server;

	root /var/www;
	index index.php index.html index.htm index.nginx-debian.html;

	server_name "$hostname";

	include /etc/nginx/sites-dietpi/*.conf;

	# PHP PRIMUL: regex-urile se evalueaza in ordinea din fisier,
	# deci blocul .php trebuie sa fie inaintea oricarui alt regex.
	location ~ \.php(?:$|/) {
		include snippets/fastcgi-php.conf;
		fastcgi_pass php;
	}

	# .pkg: descarcare cu range, ca PS4 sa poata relua transferul
	location ~* \.pkg$ {
		default_type application/octet-stream;
		add_header Accept-Ranges bytes;
	}

	# listare folder pachete (fallback daca PHP nu merge)
	location /packages/ {
		autoindex on;
		autoindex_exact_size off;
		autoindex_localtime on;
	}

	location / {
		try_files $uri $uri/ =404;
	}

	location ~ /\.ht {
		deny all;
	}

	error_page 404 /404.html;
}
